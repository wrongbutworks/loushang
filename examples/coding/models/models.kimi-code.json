            "reasoningFormat": "moonshot",
            "developerRole": false
          },
          "models": {
            "kimi-code": {
              "displayName": "Kimi for Coding (OpenAI Compatible)",
              "family": "kimi",
              "alias": "default-coding",
              "knowledge": "2025-01",
              "releaseDate": "2026-01",
              "lastUpdated": "2026-01",

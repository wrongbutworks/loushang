{
  "providers": {
    "moonshot": {
      "displayName": "Moonshot AI",
      "website": "https://www.moonshot.ai",
      "auth": {
        "kind": "apiKey",
        "apiKeyEnv": "MOONSHOT_API_KEY",
        "header": "x-api-key",
        "prefix": "",
        "extraHeaders": {
          "User-Agent": "KimiCLI/1.5"
        }
      },
      "endpoints": {

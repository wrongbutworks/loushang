# Kimi Code 示例环境变量（按需拷贝到 shell 会话）
export KIMI_AUTH_TOKEN="sk-xxx"
# 兼容旧变量（可选）
export KIMI_API_KEY="${KIMI_AUTH_TOKEN}"
export KIMI_MODEL_NAME="kimi-for-coding"
export MOONSHOT_ANTHROPIC_MESSAGES_URL="https://api.kimi.com/coding/"
export KIMI_MODEL_MAX_CONTEXT_SIZE="262144"
export KIMI_MODEL_CAPABILITIES="thinking,image_in"
export KIMI_MODEL_TEMPERATURE="0.7"
export KIMI_MODEL_TOP_P="0.9"
export KIMI_MODEL_MAX_TOKENS="4096"

# 默认示例运行仍走 Anthropic endpoint（moonshot/anthropic-messages），
# 如需显式走 Kimi Code OpenAI 兼容端点请在示例内显式指定 endpoint_id="kimi-code-openai"。
export MOONSHOT_CODING_CHAT_URL="https://api.kimi.com/coding/v1"

# loushang 示例运行器可选变量
# export LOUSHANG_EXAMPLES_ARTIFACT_ROOT=/path/to/repo/examples/coding/.loushang
# export LOUSHANG_EXAMPLES_MODEL_CATALOG=/path/to/repo/examples/coding/.loushang/models

{
  "schemaVersion": 2,
  "providers": {
    "anthropic": {
      "displayName": "Anthropic",
      "website": "https://docs.anthropic.com",
      "auth": {
        "kind": "apiKey",
        "apiKeyEnv": "ANTHROPIC_API_KEY",
        "header": "x-api-key",
        "prefix": "",
        "extraHeaders": {
          "anthropic-version": "2023-06-01"
        }
      },
      "endpoints": {
        "anthropic-messages": {
          "displayName": "Anthropic Messages API",
          "api": "anthropic-messages",
          "baseUrl": "https://api.anthropic.com",
          "preferred": true,
          "docs": "https://docs.anthropic.com/en/api/messages",
          "protocol": {
            "streaming": {
              "usage": "supported",
              "reasoningDelta": "supported"
            },
            "reasoning": {
              "interleaved": "supported"
            },
            "tools": {
              "fineGrained": "supported"
            },
            "cache": {
              "longRetention": "supported"
            }
          },
          "dialect": {
            "maxOutputTokensField": "max_tokens",
            "reasoning": {
              "assistantContentRequired": false,
              "thinkingAsText": false,
              "wireFormat": "anthropic"
            },
            "cache": {
              "controlFormat": "anthropic"
            }
          },
          "models": {
            "claude-opus-4-8": {
              "displayName": "Claude Opus 4.8",
              "family": "claude-opus-4-8",
              "defaults": {
                "maxTokens": 32000
              },
              "capabilities": {
                "contextWindow": 1000000,
                "maxTokens": 128000,
                "input": [
                  "text",
                  "image"
                ],
                "output": [
                  "text"
                ],
                "reasoning": true,
                "stream": true,
                "toolUse": true,
                "structuredOutput": true,
                "attachment": false,
                "temperature": false
              },
              "pricing": {
                "currency": "USD",
                "input": 5,
                "output": 25,
                "cacheRead": 0.5,
                "cacheWrite": 6.25
              }
            },
            "claude-sonnet-4-6": {
              "displayName": "Claude Sonnet 4.6",
              "family": "claude-sonnet-4-6",
              "defaults": {
                "maxTokens": 32000
              },
              "capabilities": {
                "contextWindow": 1000000,
                "maxTokens": 64000,
                "input": [
                  "text",
                  "image"
                ],
                "output": [
                  "text"
                ],
                "reasoning": true,
                "stream": true,
                "toolUse": true,
                "structuredOutput": true,
                "attachment": false,
                "temperature": true
              },
              "pricing": {
                "currency": "USD",
                "input": 3,
                "output": 15,
                "cacheRead": 0.3,
                "cacheWrite": 3.75
              }
            }
          }
        }
      }
    },
    "moonshot": {
      "displayName": "Moonshot AI",
      "website": "https://platform.kimi.ai",
      "auth": {
        "kind": "apiKey",
        "apiKeyEnv": "MOONSHOT_API_KEY",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "endpoints": {
        "openai-completions": {
          "displayName": "Moonshot OpenAI-compatible Chat Completions",
          "api": "openai-completions",
          "baseUrl": "https://api.moonshot.ai/v1",
          "preferred": true,
          "docs": "https://platform.kimi.ai/docs/api-reference",
          "protocol": {
            "store": "unsupported",
            "roles": {
              "developer": "unsupported"
            },
            "streaming": {
              "usage": "supported",
              "reasoningDelta": "supported"
            },
            "reasoning": {
              "effort": "unsupported"
            },
            "tools": {
              "strictSchema": "unsupported"
            }
          },
          "dialect": {
            "maxOutputTokensField": "max_tokens",
            "reasoning": {
              "assistantContentRequired": false,
              "thinkingAsText": false,
              "wireFormat": "moonshot"
            }
          },
          "models": {
            "kimi-k2.6": {
              "displayName": "Kimi K2.6",
              "family": "kimi-k2",
              "alias": "default-chat",
              "defaults": {
                "maxOutputTokens": 32000,
                "reasoningEffort": "medium"
              },
              "capabilities": {
                "contextWindow": 262144,
                "input": [
                  "text",
                  "image"
                ],
                "output": [
                  "text"
                ],
                "reasoning": true,
                "stream": true,
                "toolUse": true,
                "structuredOutput": true,
                "attachment": false,
                "temperature": true
              },
              "pricing": {
                "currency": "USD",
                "input": 0.95,
                "output": 4,
                "cacheRead": 0.16
              }
            },
            "kimi-k2.7-code": {
              "displayName": "Kimi K2.7 Code",
              "family": "kimi-k2-code",
              "alias": "default-coding",
              "defaults": {
                "maxOutputTokens": 32000,
                "reasoningEffort": "medium"
              },
              "capabilities": {
                "contextWindow": 262144,
                "input": [
                  "text",
                  "image"
                ],
                "output": [
                  "text"
                ],
                "reasoning": true,
                "stream": true,
                "toolUse": true,
                "structuredOutput": true,
                "attachment": false,
                "temperature": false
              },
              "pricing": {
                "currency": "USD",
                "input": 0.95,
                "output": 4,
                "cacheRead": 0.19
              }
            }
          }
        }
      }
    },
    "openai": {
      "displayName": "OpenAI",
      "website": "https://platform.openai.com",
      "auth": {
        "kind": "apiKey",
        "apiKeyEnv": "OPENAI_API_KEY",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "endpoints": {
        "openai-responses": {
          "displayName": "OpenAI Responses API",
          "api": "openai-responses",
          "baseUrl": "https://api.openai.com/v1",
          "preferred": true,
          "docs": "https://developers.openai.com/api/reference/resources/responses/methods/create",
          "protocol": {
            "store": "supported",
            "roles": {
              "developer": "supported"
            },
            "streaming": {
              "usage": "supported",
              "reasoningDelta": "supported"
            },
            "reasoning": {
              "effort": "supported",
              "effortMap": {
                "off": "none",
                "low": "low",
                "medium": "medium",
                "high": "high",
                "xhigh": "xhigh"
              }
            },
            "tools": {
              "strictSchema": "supported"
            }
          },
          "dialect": {
            "maxOutputTokensField": "max_output_tokens",
            "tools": {
              "assistantBridgeRequired": false,
              "resultNameRequired": false,
              "streamFlag": false
            },
            "reasoning": {
              "assistantContentRequired": false,
              "thinkingAsText": false,
              "wireFormat": "responses"
            }
          },
          "transport": {
            "kind": "http",
            "stream": "sse"
          },
          "models": {
            "gpt-5.5": {
              "displayName": "GPT-5.5",
              "family": "gpt-5",
              "knowledge": "2025-12-01",
              "defaults": {
                "maxOutputTokens": 32000,
                "reasoningEffort": "medium"
              },
              "capabilities": {
                "contextWindow": 1000000,
                "maxTokens": 128000,
                "input": [
                  "text",
                  "image"
                ],
                "output": [
                  "text"
                ],
                "reasoning": true,
                "stream": true,
                "toolUse": true,
                "structuredOutput": true,
                "attachment": false,
                "temperature": true
              },
              "pricing": {
                "currency": "USD",
                "input": 5,
                "output": 30,
                "cacheRead": 0.5
              }
            },
            "gpt-5.4-mini": {
              "displayName": "GPT-5.4 mini",
              "family": "gpt-5",
              "knowledge": "2025-08-31",
              "defaults": {
                "maxOutputTokens": 32000,
                "reasoningEffort": "medium"
              },
              "capabilities": {
                "contextWindow": 400000,
                "maxTokens": 128000,
                "input": [
                  "text",
                  "image"
                ],
                "output": [
                  "text"
                ],
                "reasoning": true,
                "stream": true,
                "toolUse": true,
                "structuredOutput": true,
                "attachment": false,
                "temperature": true
              },
              "pricing": {
                "currency": "USD",
                "input": 0.75,
                "output": 4.5,
                "cacheRead": 0.075
              }
            }
          }
        }
      }
    }
  }
}

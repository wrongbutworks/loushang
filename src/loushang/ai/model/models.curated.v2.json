{
  "schemaVersion": 2,
  "providers": {
    "openai": {
      "displayName": "OpenAI",
      "website": "https://platform.openai.com",
      "auth": {
        "kind": "apiKey",
        "apiKeyEnv": "OPENAI_API_KEY",
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "endpoints": {
        "openai-responses": {
          "displayName": "OpenAI Responses API",
          "api": "openai-responses",
          "baseUrl": "https://api.openai.com/v1",
          "preferred": true,
          "docs": "https://developers.openai.com/api/reference/resources/responses/methods/create",
          "protocol": {
            "store": "supported",
            "roles": {
              "developer": "supported"
            },
            "streaming": {
              "usage": "supported",
              "reasoningDelta": "supported"
            },
            "reasoning": {
              "effort": "supported",
              "effortMap": {
                "off": "none",
                "low": "low",
                "medium": "medium",
                "high": "high",
                "xhigh": "xhigh"
              }
            },
            "tools": {
              "strictSchema": "supported"
            }
          },
          "dialect": {
            "maxOutputTokensField": "max_output_tokens",
            "tools": {
              "assistantBridgeRequired": false,
              "resultNameRequired": false,
              "streamFlag": false
            },
            "reasoning": {
              "assistantContentRequired": false,
              "thinkingAsText": false,
              "wireFormat": "responses"
            }
          },
          "transport": {
            "kind": "http",
            "stream": "sse"
          },
          "models": {
            "gpt-5.5": {
              "displayName": "GPT-5.5",
              "family": "gpt-5",
              "knowledge": "2025-12-01",
              "defaults": {
                "maxOutputTokens": 32000,
                "reasoningEffort": "medium"
              },
              "capabilities": {
                "contextWindow": 1000000,
                "maxTokens": 128000,
                "input": [
                  "text",
                  "image"
                ],
                "output": [
                  "text"
                ],
                "reasoning": true,
                "stream": true,
                "toolUse": true,
                "structuredOutput": true,
                "attachment": false,
                "temperature": true
              },
              "pricing": {
                "currency": "USD",
                "input": 5,
                "output": 30,
                "cacheRead": 0.5
              }
            },
            "gpt-5.4-mini": {
              "displayName": "GPT-5.4 mini",
              "family": "gpt-5",
              "knowledge": "2025-08-31",
              "defaults": {
                "maxOutputTokens": 32000,
                "reasoningEffort": "medium"
              },
              "capabilities": {
                "contextWindow": 400000,
                "maxTokens": 128000,
                "input": [
                  "text",
                  "image"
                ],
                "output": [
                  "text"
                ],
                "reasoning": true,
                "stream": true,
                "toolUse": true,
                "structuredOutput": true,
                "attachment": false,
                "temperature": true
              },
              "pricing": {
                "currency": "USD",
                "input": 0.75,
                "output": 4.5,
                "cacheRead": 0.075
              }
            }
          }
        }
      }
    }
  }
}
